POSTGRES_DB=sns_analyzer
POSTGRES_USER=sns_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MAX_IMPORT_FILE_SIZE_BYTES=20971520
MAX_IMPORT_REQUEST_SIZE_BYTES=22020096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
CELERY_BROKER_URL=redis://redis:6379/0

# Phase 4: opt-in LIVE operations; keep false for the portfolio demo.
LIVE_MODE_ENABLED=false
SCHEDULER_TICK_SECONDS=30
JOB_REDISPATCH_SECONDS=300
# Provider core: leave all secret values empty in the public portfolio.
RUNTIME_SECRET_STORE_DIR=/var/lib/sns-analyzer/secrets
RUNTIME_SECRET_KEY=
RUNTIME_SECRET_KEY_FILE=
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRY_AFTER_SECONDS=60
JOB_STALE_SECONDS=900
X_USER_ACCESS_TOKEN=
X_USER_ACCESS_TOKEN_FILE=
X_REFRESH_TOKEN=
X_REFRESH_TOKEN_FILE=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CLIENT_SECRET_FILE=
INSTAGRAM_USER_ACCESS_TOKEN=
INSTAGRAM_USER_ACCESS_TOKEN_FILE=
INSTAGRAM_REFRESH_TOKEN=
INSTAGRAM_REFRESH_TOKEN_FILE=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_SECRET_FILE=

# Phase 6: all real X/OAuth calls require explicit local opt-in.
X_OAUTH_BOOTSTRAP_ENABLED=false
X_LIVE_SMOKE_ENABLED=false
X_LIVE_REFRESH_SMOKE_ENABLED=false
X_OAUTH_CLIENT_TYPE=
X_OAUTH_REDIRECT_URI=
X_INITIAL_MAX_RESULTS=5
X_INCREMENTAL_PAGE_SIZE=100
X_INCREMENTAL_MAX_PAGES=5
X_TOKEN_REFRESH_SKEW_SECONDS=300
X_TOKEN_EXPIRES_AT=
X_TOKEN_EXPIRES_AT_FILE=
X_CLIENT_ID_FILE=

# Phase 7: Instagram Login only. Read-only; keep every live gate false.
# Media/Insights sync remains blocked pending the official field contract.
INSTAGRAM_OAUTH_BOOTSTRAP_ENABLED=false
INSTAGRAM_LIVE_SMOKE_ENABLED=false
INSTAGRAM_LIVE_REFRESH_SMOKE_ENABLED=false
INSTAGRAM_GRAPH_API_VERSION=v26.0
# HTTPS callback must exactly match the Meta App Dashboard registration.
INSTAGRAM_OAUTH_REDIRECT_URI=
INSTAGRAM_TOKEN_REFRESH_SKEW_SECONDS=604800
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_TOKEN_EXPIRES_AT_FILE=
INSTAGRAM_TOKEN_ISSUED_AT=
INSTAGRAM_TOKEN_ISSUED_AT_FILE=
INSTAGRAM_CLIENT_ID_FILE=
# Instagram does not use a separate refresh_token; legacy variables above are unused.
